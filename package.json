  "repository": {
    "type": "git",
    "url": "git+https://github.com/red-cup-engineering/computer-systems-engineering-services-section.git",
    "directory": "services/agent-computer-system-engineering-services-section/services/agent-harness-computer-system-engineering-services-section/services/codex-harness-services-section/services/codex-harness-projection-service"
  },
  "bin": {
    "project-office-context": "./scripts/project-office-context.mjs"
  },
  "scripts": {
    "check": "node --check src/projector.mjs && node --check scripts/project-office-context.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@red-cup-engineering/agent-harness-computer-system-engineering-services-section": "workspace:*"
